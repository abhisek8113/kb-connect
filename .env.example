# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the portal front-end)
CORS_ORIGINS=http://localhost:4000,http://localhost:5173

# ── Auth ─────────────────────────────────────────────────
# Generate strong values:  openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=900            # seconds (15 min)
REFRESH_TOKEN_TTL=1209600       # seconds (14 days)
BCRYPT_ROUNDS=12

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgres://kb:kb@localhost:5432/kbconnect

# ── Jitsi Meet ───────────────────────────────────────────
# Self-hosted Jitsi domain (no phone numbers, private rooms)
JITSI_DOMAIN=meet.kongubrilliance.com
# App id + secret configured in Jitsi (prosody JWT auth)
JITSI_APP_ID=kbconnect
JITSI_APP_SECRET=change-me-jitsi-secret
# Room JWTs live only as long as a meeting slot
JITSI_TOKEN_TTL=7200
